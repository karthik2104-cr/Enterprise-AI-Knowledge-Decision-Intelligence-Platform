# Application
APP_NAME=Enterprise AI Knowledge Platform
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL in Docker; SQLite is used automatically in tests)
DATABASE_URL=postgresql+psycopg2://platform:platform@localhost:5432/enterprise_ai

# CORS / URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# AI providers: mock | openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# Retrieval
RETRIEVAL_TOP_K=8
RERANK_TOP_K=5

# Uploads
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads

# Demo user (created on first seed)
DEMO_EMAIL=analyst@northwind-demo.com
DEMO_PASSWORD=DemoPass123!
DEMO_NAME=Avery Chen
